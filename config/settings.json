{
  "_comment": "All runtime configuration. No thresholds, paths or list locations are hardcoded in code. Override any key with env BRAHMO_<KEY> (upper-case, dots -> __).",
  "db": {
    "path": "build/brahmo.sqlite",
    "migrations_dir": "migrations"
  },
  "data": {
    "cdci": "data/cdci_drug_subset.csv",
    "nlem": "data/nlem_extract.csv",
    "jan_aushadhi": "data/jan_aushadhi_extract.csv",
    "gazette": "data/regulatory_gazette_events.csv",
    "pharmacy_stock": "data/pharmacy_stock.csv",
    "interactions": "data/severe_interaction_seed.csv",
    "seed_prescriptions": "data/seed_prescriptions_template.csv",
    "ingredient_supplement": "data/supplements/ingredient_supplement.csv",
    "supplements_enabled": true,
    "_supplements_note": "Candidate-added ingredient names (no products). Set supplements_enabled=false to run on the provided files only.",
    "stock_reference_date": "2026-10-14",
    "_stock_reference_date_note": "Date against which stock expiry is judged; the packet carries no 'as of' date for the stock file."
  },
  "corpus": {
    "dir": "corpus",
    "stw_glob": "STW_*.pdf",
    "local_protocols": [
      "corpus/local_protocol_acute_fever.md"
    ],
    "metadata_path": "config/corpus_metadata.json",
    "index_path": "build/rag_index.json"
  },
  "freshness": {
    "_comment": "A data set older than max_age_days relative to the check date yields DATA_EXPIRED. Clinical cutoff dates are a product decision; these values are placeholders to be set by the clinical owner.",
    "drug_master_max_age_days": 400,
    "regulatory_max_age_days": 400,
    "interaction_seed_max_age_days": 400
  },
  "resolver": {
    "_comment": "Confidence values attached to each resolution method; nothing below auto_accept_min is ever auto-resolved.",
    "auto_accept_min": 0.9,
    "method_confidence": {
      "exact_brand_strength_form": 0.99,
      "exact_brand_strength": 0.97,
      "exact_brand_form": 0.95,
      "exact_brand_unique": 0.95,
      "brand_family_unique": 0.92,
      "normalized_billing_string": 0.93,
      "alias_table": 0.92,
      "fuzzy_suggestion": 0.5,
      "llm_suggestion": 0.6
    },
    "fuzzy_cutoff": 0.72,
    "fuzzy_max_candidates": 5,
    "llm_assist_enabled": false,
    "_brand_family_unique_note": "'Sinarest' / 'Dolo' with no strength: the brand family has exactly one variant in the serving master, so it resolves with this lower, visible confidence. A family with 2+ variants is always AMBIGUOUS."
  },
  "rail": {
    "rule_set_path": "config/rules.json",
    "reference_ceilings_path": "config/reference_ceilings.json",
    "frequency_patterns_path": "config/frequency_patterns.json",
    "restricted_severity": "MODERATE",
    "prohibited_severity": "SEVERE",
    "withdrawn_severity": "SEVERE",
    "duplicate_severity": "MODERATE",
    "interaction_require_ingredient_coverage": true,
    "allow_unsigned_class_members": false,
    "_allow_unsigned_class_members_note": "Candidate-added class->member mappings (requires_signoff=1) never produce a HIT unless this is true; they are reported as PARTIAL_COVERAGE instead."
  },
  "retrieval": {
    "bm25_k1": 1.5,
    "bm25_b": 0.75,
    "top_k": 8,
    "rrf_k": 60,
    "min_fused_score": 0.012,
    "lexical_weight": 1.0,
    "semantic_weight": 1.0,
    "current_only_default": true,
    "embedding_provider": "local_hashed",
    "embedding_model": "local-hashed-char-ngram-v1",
    "embedding_dims": 512,
    "condition_synonyms_path": "config/condition_synonyms.json"
  },
  "answering": {
    "mode": "extractive",
    "_mode_note": "extractive = deterministic verbatim decision units with citations (default, no network). llm = Claude composes from retrieved units; every claim is re-verified against cited text before it is shown.",
    "llm_model": "claude-sonnet-5-5",
    "llm_max_tokens": 1200,
    "prompt_path": "prompts/runtime/grounded_answer_v1.md",
    "max_claims": 10,
    "numeric_guard": true
  },
  "eval": {
    "expected_path": "data/eval/sample_questions_expected.json",
    "paraphrase_path": "data/eval/paraphrase_questions.json",
    "messy_spellings_path": "data/eval/messy_prescription_spellings.json"
  },
  "trace": {
    "schema_version": "1.0",
    "output_dir": "outputs"
  },
  "ingest": {
    "_comment": "Loader thresholds and confidences. Changing any of these changes every batch loaded afterwards; the config sha256 is recorded in every trace.",
    "decomposition_confidence": {
      "structured_columns": 0.98,
      "source_row_inconsistent": 0.6,
      "implausible_strength": 0.7
    },
    "strength_plausible_max_mg": 5000,
    "gazette_parse_confidence": {
      "default": 0.95,
      "unresolved_terms": 0.4,
      "ratio_qualifier": 0.5
    },
    "stock_expiring_window_months": 3,
    "jan_aushadhi_plausibility": {
      "solid_strength_suspicious_from_mg": 500,
      "generics_never_at_high_solid_strength": [
        "losartan",
        "rosuvastatin",
        "clopidogrel",
        "ondansetron",
        "levocetirizine",
        "chlorpheniramine",
        "sertraline",
        "prednisolone",
        "folic acid",
        "omeprazole",
        "domperidone",
        "glimepiride",
        "montelukast",
        "calcium carbonate",
        "iron (ferrous ascorbate)",
        "vitamin d3",
        "nimesulide",
        "serratiopeptidase",
        "trypsin-chymotrypsin",
        "thyroxine",
        "aceclofenac",
        "rabeprazole",
        "salbutamol",
        "telmisartan",
        "amlodipine",
        "hydrochlorothiazide",
        "phenylephrine",
        "nitrofurantoin",
        "clavulanic acid",
        "sitagliptin",
        "atenolol",
        "cefixime",
        "ciprofloxacin",
        "ofloxacin",
        "metformin"
      ],
      "generics_not_marketed_as_syrup": [
        "telmisartan",
        "amlodipine",
        "losartan",
        "sertraline",
        "montelukast",
        "calcium carbonate",
        "prednisolone",
        "aceclofenac",
        "cefixime",
        "iron (ferrous ascorbate)",
        "clavulanic acid"
      ]
    }
  },
  "freshness_demo": {
    "_comment": "Stretch: what happens when a new gazette notification arrives. The demo runs in its OWN database so the serving data is untouched.",
    "db_path": "build/freshness_demo.sqlite",
    "synthetic_event_file": "data/eval/freshness_demo_gazette_v2_delta.csv",
    "probe_brand": "Azee 500",
    "probe_rx_id": "RX03"
  }
}
